{
  "name": "discussions-migrations",
  "version": "1.0.0",
  "description": "Migration utility for Discussions",
  "main": "",
  "scripts": {
    "migration:create": "npx sequelize-cli migration:create",
    "migration:migrate": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize-cli db:migrate",
    "migration:migrate:production": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize-cli db:migrate --env production",
    "migration:rollback": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize-cli db:migrate:undo",
    "migration:rollback:production": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize-cli db:migrate:undo --env production"
  },
  "author": "Raphael Ragoomundun",
  "license": "MIT",
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
